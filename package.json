{
  "name": "blunderlab",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-based chess improvement: find why you blunder, test it, train it.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "bench": "vitest run --config bench/vitest.config.ts bench/node.bench.ts",
    "bench:strategy": "vitest run --config bench/vitest.config.ts bench/strategy.bench.ts",
    "test:e2e": "playwright test",
    "tactics:dataset": "vitest run --config bench/vitest.config.ts bench/tactics/build-dataset.bench.ts",
    "tactics:evaluate": "vitest run --config bench/vitest.config.ts bench/tactics/evaluate.bench.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
